<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Virement Bancaire - HosBank Private Banking</title>
    <meta name="description" content="Effectuez vos virements bancaires sécurisés depuis votre espace HosBank.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
        }

        .container {
            max-width: 860px;
            margin: 0 auto;
            padding: 32px 24px 64px;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13.5px;
            color: var(--text-muted);
            text-decoration: none;
            margin-bottom: 24px;
            transition: var(--transition);
        }
        .btn-back:hover { color: var(--gold-light); }

        .page-title {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 32px;
        }

        /* Layout grille */
        .virement-layout {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 24px;
            align-items: start;
        }

        @media (max-width: 768px) {
            .virement-layout { grid-template-columns: 1fr; }
        }

        /* Formulaire */
        .virement-form-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-md);
            padding: 28px;
            box-shadow: var(--shadow-card);
            position: relative;
            overflow: hidden;
        }

        .virement-form-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--gold-primary), var(--gold-light), transparent);
        }

        .form-card-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-card-title svg { color: var(--gold-primary); }

        .amount-input-wrap {
            position: relative;
        }

        .amount-input-wrap input {
            padding-right: 60px;
        }

        .amount-currency {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 12px;
            font-weight: 700;
            color: var(--gold-light);
            letter-spacing: 0.5px;
            pointer-events: none;
        }

        .btn-virement {
            width: 100%;
            padding: 13px 18px;
            background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold-primary) 100%);
            color: #0B0B0B;
            border: 1px solid var(--gold-light);
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(201, 162, 39, 0.25);
            font-family: var(--font-sans);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .btn-virement:hover {
            background: linear-gradient(135deg, #F3DE8A 0%, var(--gold-light) 100%);
            box-shadow: 0 6px 20px rgba(201, 162, 39, 0.4);
            transform: translateY(-1px);
        }

        /* Panel résumé */
        .summary-panel {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .summary-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-md);
            padding: 20px;
            box-shadow: var(--shadow-card);
        }

        .summary-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-muted);
            margin-bottom: 14px;
        }

        .account-mini {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            margin-bottom: 8px;
            transition: var(--transition);
        }

        .account-mini:last-child { margin-bottom: 0; }

        .account-mini-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-main);
        }

        .account-mini-rib {
            font-size: 11px;
            color: var(--text-muted);
            font-family: 'DM Sans', monospace;
            margin-top: 2px;
        }

        .account-mini-solde {
            font-size: 14px;
            font-weight: 800;
            color: var(--gold-light);
            font-family: 'DM Sans', sans-serif;
            white-space: nowrap;
        }

        /* Historique virements */
        .historique-section {
            margin-top: 32px;
        }

        .section-title {
            font-size: 17px;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
        }

        .virement-type-debit { color: var(--danger); font-weight: 700; font-family: 'DM Sans', monospace; }
        .virement-type-credit { color: var(--success); font-weight: 700; font-family: 'DM Sans', monospace; }

        .empty-state {
            text-align: center;
            padding: 36px;
            color: var(--text-muted);
            font-size: 14px;
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-md);
        }

        .secure-info {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 14px;
            padding: 10px 14px;
            background: var(--gold-muted);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-sm);
        }
        .secure-info svg { color: var(--gold-light); flex-shrink: 0; }
    </style>
</head>
<body>
    <!-- Navbar -->
    <header class="navbar">
        <a href="/client/dashboard" class="navbar-brand">
            <div class="brand-icon">H</div>
            <span>Hos<span>Bank</span></span>
        </a>

        <nav class="navbar-nav">
            <a href="/client/dashboard" class="nav-link">Tableau de bord</a>
            <a href="/client/beneficiaires" class="nav-link">Bénéficiaires</a>
            <a href="/client/virement" class="nav-link active">Virement</a>
            <a href="/client/carte" class="nav-link">Carte Virtuelle</a>
        </nav>

        <div style="display:flex; align-items:center; gap:12px;">
            <a href="/client/profile" class="btn btn-outline btn-sm">Mon profil</a>
            <a href="/auth/logout" class="btn-logout">Déconnexion</a>
        </div>
    </header>

    <main class="container">
        <a href="/client/dashboard" class="btn-back">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Retour au tableau de bord
        </a>

        <div class="page-title">Effectuer un Virement</div>
        <p class="page-subtitle">Transférez des fonds en toute sécurité depuis votre espace bancaire HosBank.</p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span><%= success %></span>
            </div>
        <% } %>

        <div class="virement-layout">
            <!-- Formulaire de virement -->
            <div class="virement-form-card">
                <div class="form-card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    Nouveau virement
                </div>

                <form action="/client/virement" method="POST" id="form-virement">
                    <div class="form-group">
                        <label for="sourceAccountId">Compte source</label>
                        <select id="sourceAccountId" name="sourceAccountId" class="form-control" required>
                            <option value="">-- Sélectionner votre compte --</option>
                            <% if (comptes && comptes.length > 0) { %>
                                <% comptes.forEach(function(compte) { %>
                                    <option value="<%= compte.id %>">
                                        <%= compte.labelType %> — Solde : <%= compte.soldeFormatted %>
                                    </option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="beneficiaireId">Bénéficiaire</label>
                        <select id="beneficiaireId" name="beneficiaireId" class="form-control" required>
                            <option value="">-- Sélectionner un bénéficiaire --</option>
                            <% if (beneficiaires && beneficiaires.length > 0) { %>
                                <% beneficiaires.forEach(function(b) { %>
                                    <option value="<%= b.id %>">
                                        <%= b.nom_beneficiaire %> — RIB: <%= b.rib %>
                                    </option>
                                <% }); %>
                            <% } else { %>
                                <option value="" disabled>Aucun bénéficiaire enregistré</option>
                            <% } %>
                        </select>
                        <% if (!beneficiaires || beneficiaires.length === 0) { %>
                            <div style="font-size:12px; color:var(--gold-light); margin-top:6px;">
                                <a href="/client/beneficiaires" style="color:var(--gold-light);">+ Ajouter un bénéficiaire</a> avant d'effectuer un virement.
                            </div>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="amount">Montant du virement</label>
                        <div class="amount-input-wrap">
                            <input
                                type="number"
                                id="amount"
                                name="amount"
                                class="form-control"
                                placeholder="0.00"
                                min="1"
                                step="0.01"
                                required
                            >
                            <span class="amount-currency">MAD</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="motif">Motif (optionnel)</label>
                        <input
                            type="text"
                            id="motif"
                            name="motif"
                            class="form-control"
                            placeholder="ex: Remboursement loyer, Pension..."
                            maxlength="100"
                        >
                    </div>

                    <button type="submit" class="btn-virement" id="btn-confirmer-virement">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                        Confirmer le virement
                    </button>
                </form>

                <div class="secure-info">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    Virement sécurisé — Vos transactions sont chiffrées et protégées.
                </div>
            </div>

            <!-- Panneau résumé des comptes -->
            <div class="summary-panel">
                <div class="summary-card">
                    <div class="summary-title">Mes comptes disponibles</div>
                    <% if (comptes && comptes.length > 0) { %>
                        <% comptes.forEach(function(compte) { %>
                            <div class="account-mini">
                                <div>
                                    <div class="account-mini-name"><%= compte.labelType %></div>
                                    <div class="account-mini-rib"><%= compte.ribFormatted || compte.rib %></div>
                                </div>
                                <div class="account-mini-solde"><%= compte.soldeFormatted %></div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p style="font-size:13px; color:var(--text-muted);">Aucun compte actif disponible.</p>
                    <% } %>
                </div>

                <% if (beneficiaires && beneficiaires.length > 0) { %>
                <div class="summary-card">
                    <div class="summary-title">Bénéficiaires enregistrés</div>
                    <% beneficiaires.forEach(function(b) { %>
                        <div class="account-mini">
                            <div>
                                <div class="account-mini-name"><%= b.nom_beneficiaire %></div>
                                <div class="account-mini-rib"><%= b.rib %></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Historique des virements -->
        <div class="historique-section">
            <div class="section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--gold-primary)" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                Historique des virements
            </div>

            <% if (virements && virements.length > 0) { %>
                <div class="table-container" style="background:var(--bg-surface); border:1px solid var(--border-card); border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-card);">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Motif</th>
                                <th>Compte source</th>
                                <th>Compte dest.</th>
                                <th>Statut</th>
                                <th style="text-align:right;">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% virements.forEach(function(v) { %>
                                <tr>
                                    <td>
                                        <%= new Date(v.created_at).toLocaleDateString('fr-FR', {
                                            day: '2-digit', month: 'short', year: 'numeric',
                                            hour: '2-digit', minute: '2-digit'
                                        }) %>
                                    </td>
                                    <td><strong><%= v.motif || 'Virement bancaire' %></strong></td>
                                    <td style="font-family:'DM Sans',monospace; font-size:12px;"><%= v.rib_source ? v.rib_source.slice(-8) : '—' %></td>
                                    <td style="font-family:'DM Sans',monospace; font-size:12px;"><%= v.rib_destination ? v.rib_destination.slice(-8) : '—' %></td>
                                    <td><span class="badge badge-success"><%= v.statut %></span></td>
                                    <td style="text-align:right;">
                                        <span class="<%= v.type_operation === 'debit' ? 'virement-type-debit' : 'virement-type-credit' %>">
                                            <%= v.type_operation === 'debit' ? '-' : '+' %>
                                            <%= Number(v.montant).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> MAD
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px; color:var(--text-dim);"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    <p>Aucun virement effectué pour le moment.</p>
                </div>
            <% } %>
        </div>
    </main>

    <script>
        // Confirmation avant soumission
        document.getElementById('form-virement').addEventListener('submit', function(e) {
            const amount = document.getElementById('amount').value;
            const source = document.getElementById('sourceAccountId');
            const dest = document.getElementById('beneficiaireId');
            const sourceText = source.options[source.selectedIndex]?.text || '';
            const destText = dest.options[dest.selectedIndex]?.text || '';

            if (!source.value || !dest.value || !amount) return;

            const confirmed = confirm(
                `Confirmer ce virement ?\n\nDe : ${sourceText}\nVers : ${destText}\nMontant : ${Number(amount).toLocaleString('fr-FR', {minimumFractionDigits: 2})} MAD`
            );

            if (!confirmed) e.preventDefault();
        });
    </script>
</body>
</html>
