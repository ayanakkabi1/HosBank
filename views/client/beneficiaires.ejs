<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes Bénéficiaires - HosBank Private Banking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 32px 24px 64px;
        }

        .page-title {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .page-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 28px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 14px;
            align-items: end;
        }

        @media (max-width: 640px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }

        .beneficiaire-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .beneficiaire-item {
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-md);
            padding: 18px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: var(--transition);
            box-shadow: var(--shadow-card);
        }

        .beneficiaire-item:hover {
            border-color: var(--gold-border);
            transform: translateY(-1px);
        }

        .beneficiaire-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .beneficiaire-nom {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-main);
        }

        .beneficiaire-rib {
            font-size: 12.5px;
            font-family: 'DM Sans', monospace;
            color: var(--gold-light);
            letter-spacing: 0.5px;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
            font-size: 14px;
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-md);
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13.5px;
            color: var(--text-muted);
            text-decoration: none;
            margin-bottom: 20px;
            transition: var(--transition);
        }

        .btn-back:hover {
            color: var(--gold-light);
        }
        .beneficiaire-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-edit {
            background: rgba(200, 169, 95, 0.12);
            color: var(--gold-light);
            border: 1px solid var(--gold-border);
            padding: 6px 14px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-edit:hover {
            background: var(--gold-primary);
            color: #0d1117;
            transform: translateY(-1px);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-lg);
            padding: 28px;
            width: 100%;
            max-width: 520px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            animation: modalFadeIn 0.25s ease-out;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(-10px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .modal-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-main);
        }

        .modal-close {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 22px;
            cursor: pointer;
            line-height: 1;
            padding: 4px;
            transition: var(--transition);
        }

        .modal-close:hover {
            color: var(--text-main);
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
        }

        .form-hint {
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }
    </style>
</head>
<body>
    
    <header class="navbar">
        <a href="/client/dashboard" class="navbar-brand">
            <div class="brand-icon">H</div>
            <span>Hos<span>Bank</span></span>
        </a>

        <nav class="navbar-nav">
            <a href="/client/dashboard" class="nav-link">Tableau de bord</a>
            <a href="/client/beneficiaires" class="nav-link active">Bénéficiaires</a>
            <a href="/client/carte" class="nav-link">Carte Virtuelle</a>
        </nav>

        <a href="/auth/logout" class="btn-logout">Déconnexion</a>
    </header>

    <main class="container">
        
        <a href="/client/dashboard" class="btn-back">← Retour au tableau de bord</a>

        <div class="page-title">Mes Bénéficiaires</div>
        <p class="page-subtitle">Gérez vos bénéficiaires pour exécuter vos virements bancaires en toute sérénité.</p>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <div class="card">
            <div class="card-title">Ajouter un nouveau bénéficiaire</div>
            <form action="/client/beneficiaires" method="POST">
                <div class="form-row">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label for="nom_beneficiaire">Nom complet du titulaire</label>
                        <input
                            type="text"
                            id="nom_beneficiaire"
                            name="nom_beneficiaire"
                            class="form-control"
                            placeholder="ex: Mohamed Alami"
                            pattern="^[A-Za-zÀ-ÖØ-öø-ÿ\s'-]+$"
                            title="Le nom doit contenir uniquement des lettres"
                            oninput="this.value = this.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ\s'-]/g, '')"
                            required
                        >
                        <div class="form-hint">Uniquement des lettres et espaces</div>
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label for="rib">RIB marocain (24 chiffres)</label>
                        <input
                            type="text"
                            id="rib"
                            name="rib"
                            class="form-control"
                            placeholder="ex: 230000123456789012345678"
                            pattern="^\d{24}$"
                            maxlength="24"
                            title="Le RIB doit contenir exactement 24 chiffres"
                            oninput="this.value = this.value.replace(/\D/g, '')"
                            required
                        >
                        <div class="form-hint">Exactement 24 chiffres</div>
                    </div>
                    <button type="submit" class="btn btn-primary" style="height: 42px;">+ Ajouter</button>
                </div>
            </form>
        </div>

        <!-- Liste des bénéficiaires -->
        <div class="card-title" style="margin-bottom: 16px;">Liste de vos bénéficiaires (<%= beneficiaires.length %>)</div>

        <% if (beneficiaires && beneficiaires.length > 0) { %>
            <div class="beneficiaire-list">
                <% beneficiaires.forEach(function(b) { %>
                    <div class="beneficiaire-item">
                        <div class="beneficiaire-info">
                            <span class="beneficiaire-nom"><%= b.nom_beneficiaire %></span>
                            <span class="beneficiaire-rib">RIB : <%= b.rib %></span>
                        </div>
                        <div class="beneficiaire-actions">
                            <button 
                                type="button" 
                                class="btn-edit btn-trigger-edit"
                                data-id="<%= b.id %>"
                                data-nom="<%= b.nom_beneficiaire %>"
                                data-rib="<%= b.rib %>">
                                Modifier
                            </button>
                            <form action="/client/beneficiaires/<%= b.id %>/delete" method="POST" style="margin: 0;">
                                <button type="submit" class="btn btn-danger-outline btn-sm"
                                    onclick="return confirm('Voulez-vous supprimer ce bénéficiaire ?')">
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-state">
                Aucun bénéficiaire enregistré pour le moment.
            </div>
        <% } %>
    </main>

    <!-- Modal Modification Bénéficiaire -->
    <div id="editModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-title">Modifier le bénéficiaire</div>
                <button type="button" class="modal-close" onclick="closeEditModal()">&times;</button>
            </div>
            <form id="editForm" method="POST">
                <div class="form-group">
                    <label for="edit_nom_beneficiaire">Nom complet du titulaire</label>
                    <input
                        type="text"
                        id="edit_nom_beneficiaire"
                        name="nom_beneficiaire"
                        class="form-control"
                        pattern="^[A-Za-zÀ-ÖØ-öø-ÿ\s'-]+$"
                        title="Le nom doit contenir uniquement des lettres"
                        oninput="this.value = this.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ\s'-]/g, '')"
                        required
                    >
                    <div class="form-hint">Uniquement des lettres et espaces</div>
                </div>
                <div class="form-group">
                    <label for="edit_rib">RIB marocain (24 chiffres)</label>
                    <input
                        type="text"
                        id="edit_rib"
                        name="rib"
                        class="form-control"
                        pattern="^\d{24}$"
                        maxlength="24"
                        title="Le RIB doit contenir exactement 24 chiffres"
                        oninput="this.value = this.value.replace(/\D/g, '')"
                        required
                    >
                    <div class="form-hint">Exactement 24 chiffres</div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditModal(id, nom, rib) {
            const form = document.getElementById('editForm');
            form.action = `/client/beneficiaires/${id}/update`;
            document.getElementById('edit_nom_beneficiaire').value = nom;
            document.getElementById('edit_rib').value = rib;
            document.getElementById('editModal').classList.add('active');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.remove('active');
        }

        document.querySelectorAll('.btn-trigger-edit').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const nom = this.getAttribute('data-nom');
                const rib = this.getAttribute('data-rib');
                openEditModal(id, nom, rib);
            });
        });

        // Fermer le modal en cliquant à l'extérieur
        window.addEventListener('click', function(e) {
            const modal = document.getElementById('editModal');
            if (e.target === modal) {
                closeEditModal();
            }
        });
    </script>
</body>
</html>
