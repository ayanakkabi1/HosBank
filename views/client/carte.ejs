<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demande de Carte Virtuelle - HosBank Private Banking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 32px 24px 64px;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13.5px;
            color: var(--text-muted);
            text-decoration: none;
            margin-bottom: 20px;
            transition: var(--transition);
        }

        .btn-back:hover {
            color: var(--gold-light);
        }

        .page-title {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .page-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 28px;
        }

        .card-preview-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-md);
            padding: 32px;
            margin-bottom: 36px;
            align-items: center;
            box-shadow: var(--shadow-card);
        }

        @media (max-width: 768px) {
            .card-preview-section {
                grid-template-columns: 1fr;
            }
        }

        
        .virtual-card {
            background: linear-gradient(135deg, #1C1C1C 0%, #0E0E0E 60%, #151515 100%);
            border: 1px solid var(--gold-border);
            border-radius: 12px;
            padding: 24px;
            color: var(--text-main);
            height: 210px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7), var(--gold-glow);
            position: relative;
            overflow: hidden;
        }

        .virtual-card::after {
            content: '';
            position: absolute;
            top: -40px;
            right: -40px;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(201, 162, 39, 0.15) 0%, transparent 70%);
            pointer-events: none;
        }

        .card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-logo {
            font-weight: 800;
            font-size: 16px;
            letter-spacing: 0.5px;
            color: var(--text-main);
        }

        .card-logo span {
            color: var(--gold-primary);
        }

        .card-chip {
            width: 40px;
            height: 30px;
            background: linear-gradient(135deg, #D4AF37 0%, #AA8012 100%);
            border-radius: 6px;
            box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.4);
        }

        .card-number {
            font-size: 19px;
            letter-spacing: 3px;
            font-weight: 700;
            color: var(--gold-light);
            font-family: 'DM Sans', monospace;
        }

        .card-bottom {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            font-size: 11.5px;
        }

        .card-holder {
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: var(--text-secondary);
        }

        .card-badge {
            background: var(--gold-muted);
            border: 1px solid var(--gold-border);
            color: var(--gold-light);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .info-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 10px;
        }

        .info-desc {
            font-size: 13.5px;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 18px;
        }

        .card-features {
            list-style: none;
            margin-bottom: 24px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .card-features li {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .feature-icon {
            color: var(--gold-light);
            font-weight: bold;
        }

        .table-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-card);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-card);
        }

        .badge-en_attente {
            background-color: var(--warning-bg);
            color: var(--gold-light);
            border: 1px solid var(--warning-border);
        }

        .badge-validee {
            background-color: var(--success-bg);
            color: var(--success);
            border: 1px solid var(--success-border);
        }

        .badge-refusee {
            background-color: var(--danger-bg);
            color: var(--danger);
            border: 1px solid var(--danger-border);
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
            font-size: 14px;
        }
    </style>
</head>
<body>
    
    <header class="navbar">
        <a href="/client/dashboard" class="navbar-brand">
            <div class="brand-icon">H</div>
            <span>Hos<span>Bank</span></span>
        </a>

        <nav class="navbar-nav">
            <a href="/client/dashboard" class="nav-link">Tableau de bord</a>
            <a href="/client/beneficiaires" class="nav-link">Bénéficiaires</a>
            <a href="/client/carte" class="nav-link active">Carte Virtuelle</a>
        </nav>

        <a href="/auth/logout" class="btn-logout">Déconnexion</a>
    </header>

    <main class="container">
        <a href="/client/dashboard" class="btn-back">← Retour au tableau de bord</a>

        <div class="page-title">Demande de Carte Virtuelle</div>
        <p class="page-subtitle">Commandez votre carte bancaire virtuelle exclusive pour vos règlements en ligne sécurisés.</p>

        
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        
        <div class="card-preview-section">
            <div class="virtual-card">
                <div class="card-top">
                    <span class="card-logo">Hos<span>Bank</span></span>
                    <div class="card-chip"></div>
                </div>
                <div class="card-number">•••• •••• •••• ••••</div>
                <div class="card-bottom">
                    <div class="card-holder"><%= (user && (user.prenom + ' ' + user.nom)) || 'CLIENT HOSBANK' %></div>
                    <span class="card-badge">VIRTUELLE</span>
                </div>
            </div>

            <div>
                <div class="info-title">Paiements numériques sécurisés</div>
                <p class="info-desc">
                    Votre carte virtuelle vous permet de régler vos transactions en ligne sans exposer les coordonnées de votre compte principal.
                </p>
                <ul class="card-features">
                    <li><span class="feature-icon">✦</span> Plafond personnalisable jusqu'à 5 000 MAD</li>
                    <li><span class="feature-icon">✦</span> Activation instantanée dès validation par votre conseiller</li>
                    <li><span class="feature-icon">✦</span> Blocage et déblocage immédiats depuis votre espace</li>
                </ul>

                <form action="/client/carte" method="POST">
                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px 24px;" id="btn-demande-carte">
                        Demander ma carte virtuelle
                    </button>
                </form>
            </div>
        </div>

        <!-- Historique des demandes -->
        <div class="card-title" style="margin-bottom: 16px;">
            Mes demandes de cartes (<%= (demandes && demandes.length) || 0 %>)
        </div>

        <div class="table-card">
            <% if (demandes && demandes.length > 0) { %>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>N° Référence</th>
                                <th>Type de demande</th>
                                <th>Date d'émission</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% demandes.forEach(function(demande) { %>
                                <tr>
                                    <td><strong>#DEM-<%= demande.id %></strong></td>
                                    <td>Carte Virtuelle Exclusive</td>
                                    <td>
                                        <%= new Date(demande.created_at).toLocaleDateString('fr-FR', {
                                            year: 'numeric',
                                            month: 'short',
                                            day: 'numeric',
                                            hour: '2-digit',
                                            minute: '2-digit'
                                        }) %>
                                    </td>
                                    <td>
                                        <% if (demande.statut === 'en_attente') { %>
                                            <span class="badge badge-en_attente">En attente</span>
                                        <% } else if (demande.statut === 'validee') { %>
                                            <span class="badge badge-validee">Validée</span>
                                        <% } else if (demande.statut === 'refusee') { %>
                                            <span class="badge badge-refusee">Refusée</span>
                                        <% } else { %>
                                            <span class="badge badge-warning"><%= demande.statut %></span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    Vous n'avez pas encore effectué de demande de carte virtuelle.
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
