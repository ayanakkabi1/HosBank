<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vérification de l'adresse e-mail - HosBank Private Banking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        .auth-container {
            width: 100%;
            max-width: 480px;
            background: var(--bg-surface);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-md);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.8), var(--gold-glow);
            overflow: hidden;
            text-align: center;
            position: relative;
        }

        .auth-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--gold-primary), var(--gold-light), transparent);
        }

        .auth-header {
            padding: 32px 24px 20px;
            border-bottom: 1px solid var(--border-subtle);
            background: linear-gradient(180deg, rgba(201, 162, 39, 0.04) 0%, transparent 100%);
        }

        .brand-logo-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .brand-logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold-primary) 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(201, 162, 39, 0.35);
        }

        .brand-logo-icon svg {
            width: 20px;
            height: 20px;
            fill: #0B0B0B;
        }

        .brand-logo-text {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--text-main);
        }

        .brand-logo-text span {
            color: var(--gold-primary);
        }

        .auth-body {
            padding: 40px 32px;
        }

        .status-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }

        .status-icon.success {
            background-color: var(--success-bg);
            color: var(--success);
            border: 1px solid var(--success-border);
        }

        .status-icon.error {
            background-color: var(--danger-bg);
            color: var(--danger);
            border: 1px solid var(--danger-border);
        }

        .status-icon svg {
            width: 36px;
            height: 36px;
        }

        h2 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 12px;
        }

        p {
            font-size: 14.5px;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 28px;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-header">
            <div class="brand-logo-wrap">
                <div class="brand-logo-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                </div>
                <div class="brand-logo-text">Hos<span>Bank</span></div>
            </div>
        </div>

        <div class="auth-body">
            <% if (success) { %>
                <div class="status-icon success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h2>Activation Réussie !</h2>
                <p><%= message %></p>
                <a href="/auth/login" class="btn btn-primary" style="padding: 12px 28px;">
                    Se connecter à mon espace
                </a>
            <% } else { %>
                <div class="status-icon error">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </div>
                <h2>Échec de la validation</h2>
                <p><%= message %></p>
                <div style="display: flex; gap: 10px; justify-content: center;">
                    <a href="/auth/register" class="btn btn-primary">Créer un compte</a>
                    <a href="/auth/login" class="btn btn-outline">Connexion</a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
