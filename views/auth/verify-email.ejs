<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vérification de l'adresse e-mail - HosBank</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --navy-dark: #0f172a;
            --slate-800: #1e293b;
            --slate-600: #475569;
            --slate-400: #94a3b8;
            --slate-200: #e2e8f0;
            --slate-50: #f8fafc;
            --danger: #ef4444;
            --success: #10b981;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--slate-50);
            color: var(--navy-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        .auth-container {
            width: 100%;
            max-width: 480px;
            background: #ffffff;
            border: 1px solid var(--slate-200);
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
            overflow: hidden;
            text-align: center;
        }

        .auth-header {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            color: #ffffff;
            padding: 28px 24px;
        }

        .brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 24px;
            font-weight: 700;
        }

        .brand-logo svg {
            width: 30px;
            height: 30px;
            fill: #60a5fa;
        }

        .auth-body {
            padding: 40px 32px;
        }

        .status-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }

        .status-icon.success {
            background-color: #ecfdf5;
            color: var(--success);
        }

        .status-icon.error {
            background-color: #fef2f2;
            color: var(--danger);
        }

        .status-icon svg {
            width: 36px;
            height: 36px;
        }

        h2 {
            font-size: 22px;
            font-weight: 700;
            color: var(--navy-dark);
            margin-bottom: 12px;
        }

        p {
            font-size: 15px;
            color: var(--slate-600);
            line-height: 1.6;
            margin-bottom: 28px;
        }

        .btn-action {
            display: inline-block;
            padding: 12px 28px;
            background-color: var(--primary);
            color: #ffffff;
            text-decoration: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            transition: background-color 0.2s ease;
        }

        .btn-action:hover {
            background-color: var(--primary-hover);
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--slate-600);
            border: 1px solid var(--slate-200);
            margin-left: 10px;
        }

        .btn-secondary:hover {
            background-color: var(--slate-50);
            color: var(--navy-dark);
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-header">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
                <span>HosBank</span>
            </div>
        </div>

        <div class="auth-body">
            <% if (success) { %>
                <div class="status-icon success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h2>Activation Réussie !</h2>
                <p><%= message %></p>
                <a href="/auth/login" class="btn-action">Se connecter à mon espace</a>
            <% } else { %>
                <div class="status-icon error">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </div>
                <h2>Échec de la validation</h2>
                <p><%= message %></p>
                <a href="/auth/register" class="btn-action">Créer un compte</a>
                <a href="/auth/login" class="btn-action btn-secondary">Connexion</a>
            <% } %>
        </div>
    </div>
</body>
</html>
